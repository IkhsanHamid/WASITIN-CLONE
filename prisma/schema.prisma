generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model roles {
  id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String  @db.VarChar(255)
  users users[]
}

model access_token {
  id            String   @id @default(uuid()) @db.Uuid
  access_token  String
  created_at    DateTime @default(now())
  updated_at    DateTime
  user_id       String   @db.Uuid
  refresh_token String?
  user          users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id                                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id                                 String                 @db.Uuid
  email                                   String                 @db.VarChar(255)
  name                                    String?                @db.VarChar(255)
  password                                String?                @db.VarChar(255)
  phone                                   String?                @db.VarChar(20)
  city                                    String?                @db.VarChar(255)
  province                                String?                @db.VarChar(255)
  photo                                   String?                @db.VarChar(255)
  is_active                               Boolean                @default(true)
  created_at                              DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime?              @db.Timestamptz(6)
  google_id                               String?                @unique @db.VarChar(255)
  is_deleted                              Boolean                @default(false)
  access_token                            access_token[]
  bookings                                bookings[]
  md_banks                                md_banks[]
  md_voucher_md_voucher_created_idTousers md_voucher[]           @relation("md_voucher_created_idTousers")
  md_voucher_md_voucher_updated_idTousers md_voucher[]           @relation("md_voucher_updated_idTousers")
  ratings                                 ratings[]
  referee_banks                           referee_banks[]
  referees                                referees[]
  user_oauth_providers                    user_oauth_providers[]
  roles                                   roles                  @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_role")
}

enum RoleReferee {
  MAIN_REFEREE
  ASSISTANT_REFEREE
  LINE_REFEREE_1
  LINE_REFEREE_2
}

model booking_details {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id   String      @db.Uuid
  referee_id   String      @db.Uuid
  role_referee RoleReferee
  confirmation Boolean     @default(false)
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  bookings     bookings    @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bdetail_booking")
  referees     referees    @relation(fields: [referee_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bdetail_referee")
}

model bookings {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String            @db.Uuid
  schedule_id     String            @db.Uuid
  book_id         String            @db.VarChar(255)
  location        String?            @db.VarChar(255)
  address         String?            @db.VarChar(255)
  longitude       Decimal?           @db.Decimal(10, 7)
  latitude        Decimal?           @db.Decimal(10, 7)
  link_google_maps String?            @db.VarChar(255)
  totals          Int
  type_match      String            @db.VarChar(255)
  type_time       String            @db.VarChar(255)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  booking_details booking_details[]
  schedules       schedules         @relation(fields: [schedule_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booking_schedule")
  users           users             @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booking_user")
  payments        payments[]
}

model licenses {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referee_id    String    @db.Uuid
  name          String    @db.VarChar(255)
  license_level String    @db.VarChar(255)
  organization  String    @db.VarChar(255)
  no_license    String    @db.VarChar(255)
  expired_date  DateTime  @db.Timestamp(6)
  date_of_issue DateTime  @db.Timestamp(6)
  file_link     String    @db.VarChar(255)
  is_verified   Boolean   @default(false)
  is_deleted    Boolean   @default(false)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @db.Timestamptz(6)
  referees      referees  @relation(fields: [referee_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_licenses_referee")
}

model md_banks {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(255)
  code       String    @db.VarChar(255)
  created_id String    @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @db.Timestamptz(6)
  users      users     @relation(fields: [created_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_banks_creator")
}

model md_sports {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @db.VarChar(255)
  referee_sports referee_sports[]
}

model md_voucher {
  id                                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                               String   @db.VarChar(255)
  type                               String   @db.VarChar(255)
  amount                             Int
  created_id                         String   @db.Uuid
  updated_id                         String?  @db.Uuid
  created_at                         DateTime @default(now()) @db.Timestamptz(6)
  updated_at                         DateTime @default(now()) @db.Timestamptz(6)
  users_md_voucher_created_idTousers users    @relation("md_voucher_created_idTousers", fields: [created_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_voucher_creator")
  users_md_voucher_updated_idTousers users?   @relation("md_voucher_updated_idTousers", fields: [updated_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_voucher_updater")
}

model payments {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id     String    @db.Uuid
  total_amount   Int
  grand_total    Int
  discount       Int       @default(0)
  admin_fee      Int       @default(0)
  payment_method String    @db.VarChar(255)
  status         String    @db.VarChar(255)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @db.Timestamptz(6)
  bookings       bookings  @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_booking")
}

model ratings {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referee_id String   @db.Uuid
  user_id    String   @db.Uuid
  rating     Decimal  @db.Decimal(3, 2)
  comments   String   @db.VarChar(255)
  photos     String[] @default([]) @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  referees   referees @relation(fields: [referee_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rating_referee")
  users      users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rating_user")
}

model referee_banks {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referee_id     String   @db.Uuid
  updated_id     String   @db.Uuid
  bank_code      String   @db.VarChar(255)
  number_account String   @db.VarChar(50)
  name           String   @db.VarChar(255)
  photo_book     String   @db.VarChar(255)
  is_active      Boolean  @default(true)
  is_verified    Boolean  @default(false)
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  referees       referees @relation(fields: [referee_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rbanks_referee")
  users          users    @relation(fields: [updated_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rbanks_updater")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model referee_pricing {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referee_sport_id String         @db.Uuid
  amount           Int
  type_time        String         @db.VarChar(255)
  type_game        String         @db.VarChar(255)
  is_deleted       Boolean        @default(false)
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?      @db.Timestamptz(6)
  referee_sports   referee_sports @relation(fields: [referee_sport_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pricing_rsport")
}

model referee_sports {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referee_id      String            @db.Uuid
  sport_id        String            @db.Uuid
  referee_pricing referee_pricing[]
  referees        referees          @relation(fields: [referee_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rsports_referee")
  md_sports       md_sports         @relation(fields: [sport_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rsports_sport")
  schedules       schedules[]
}

model referees {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String                 @db.Uuid
  bio                   String?                @db.VarChar(255)
  photo_profile         String?                @db.VarChar(255)
  is_verification       Boolean                @default(false)
  verification_reason   String?                @db.VarChar(255)
  recheck_data          Boolean                @default(false)
  photos                String[]               @default([]) @db.VarChar(255)
  booking_details       booking_details[]
  licenses              licenses[]
  ratings               ratings[]
  referee_banks         referee_banks[]
  referee_sports        referee_sports[]
  users                 users                  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_referees_user")
  schedules             schedules[]
  referee_availability  referee_availability[]
}

model schedules {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referee_id       String         @db.Uuid
  referee_sport_id String         @db.Uuid
  date             DateTime       @db.Date
  start_time       DateTime       @db.Timestamp(6)
  end_time         DateTime       @db.Timestamp(6)
  is_deleted       Boolean        @default(false)
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?      @db.Timestamptz(6)
  bookings         bookings[]
  referees         referees       @relation(fields: [referee_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sched_referee")
  referee_sports   referee_sports @relation(fields: [referee_sport_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sched_rsport")
}

model user_oauth_providers {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  provider         String    @default("google") @db.VarChar(50)
  provider_id      String    @db.VarChar(255)
  access_token     String?
  refresh_token    String?
  token_expires_at DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_oauth_user")

  @@unique([provider, provider_id])
}

model md_cities {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  province_id  String       @db.Uuid
  code         String       @unique(map: "cities_code_key")
  name         String
  type         CityType
  created_at   DateTime     @default(now())
  updated_at   DateTime
  md_provinces md_provinces @relation(fields: [province_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cities_province_id_fkey")
}

model md_provinces {
  id         String      @id(map: "provinces_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String      @unique(map: "provinces_code_key")
  name       String
  created_at DateTime    @default(now())
  updated_at DateTime
  md_cities  md_cities[]
}

enum CityType {
  KABUPATEN
  KOTA
}

model password_reset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique @db.VarChar(255)
  otp       String   @db.VarChar(6)
  expires_at DateTime @db.Timestamptz(6)
  is_used   Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model referee_availability {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referee_id  String    @db.Uuid
  date        DateTime  @db.Date
  start_time  String    @db.VarChar(5)
  end_time    String    @db.VarChar(5)
  is_deleted  Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @db.Timestamptz(6)
  referees    referees  @relation(fields: [referee_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_availability_referee")
}
