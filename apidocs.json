  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register",
        "description": "**API Registration Public (Tidak perlu Token untuk mengaksesnya)**\n\nDigunakan untuk melakukan registrasi User agar bisa Login kedalam aplikasi.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "user@example.com"
                  },
                  "username": {
                    "type": "string",
                    "example": "ikhsan12345"
                  },
                  "fullname": {
                    "type": "string",
                    "example": "ikhsan"
                  },
                  "company_name": {
                    "type": "string",
                    "example": "fast tech"
                  },
                  "company_address": {
                    "type": "string",
                    "example": "fast tech"
                  },
                  "sales_code": {
                    "type": "string",
                    "example": "fast tech"
                  },
                  "phone_number": {
                    "type": "string",
                    "example": "fast tech"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "example": "password123"
                  }
                },
                "required": [
                  "email",
                  "password",
                  "username",
                  "fullname",
                  "company_name",
                  "company_address",
                  "sales_code",
                  "phone_number"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request Successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean", "example": true },
                    "statusCode": { "type": "number", "example": 201 },
                    "message": { "type": "string", "example": "Success register" },
                    "data": { "type": "null" }
                  }
                }
              }
            }
          },
          "412": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean", "example": false },
                    "statusCode": { "type": "number", "example": 412 },
                    "message": { "type": "string", "example": "Email already registered." },
                    "data": { "type": "null" }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login",
        "description": "API Login Public (Tidak perlu Token untuk mengaksesnya).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "user@example.com"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "example": "password123"
                  },
                  "is_web": {
                    "type": "boolean",
                    "example": true
                  },
                  "is_mobile": {
                    "type": "boolean",
                    "example": true
                  }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Berhasil Login",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean", "example": true },
                    "statusCode": { "type": "number", "example": 200 },
                    "message": { "type": "string", "example": "login success" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "access_token": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
